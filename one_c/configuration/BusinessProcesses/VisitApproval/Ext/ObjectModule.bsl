// Маршрут платформы: согласование отдельной ролью, затем выдача на проходной.
Процедура ApproveCreate(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
    Для Каждого Задача Из ФормируемыеЗадачи Цикл Задача.RequiredRole = "approver"; КонецЦикла;
КонецПроцедуры

Процедура ApproveExecute(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
    Если Не ЗначениеЗаполнено(Request) Тогда ВызватьИсключение "Не выбрана заявка"; КонецЕсли;
    AccessApprovals.Изменить(Задача.ActorLogin, Request, "submitted", "approved", "Согласовано в маршруте 1С");
КонецПроцедуры

Процедура IssueCreate(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
    Для Каждого Задача Из ФормируемыеЗадачи Цикл Задача.RequiredRole = "guard"; КонецЦикла;
КонецПроцедуры

Процедура IssueExecute(ТочкаМаршрутаБизнесПроцесса, Задача, Отказ)
    AccessPasses.Выдать(Задача.ActorLogin, Request);
КонецПроцедуры
