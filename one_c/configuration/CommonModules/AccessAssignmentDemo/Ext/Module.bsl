// Подготовка только отдельной пустой учебной базы; существующие данные не стираются.
Функция Документ(Имя, Логин)
    Объект = Документы[Имя].СоздатьДокумент(); Объект.Дата = ТекущаяДатаСеанса();
    Объект.ActorLogin = Логин; Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Возврат Объект;
КонецФункции

Функция Элемент(Имя, Номер, Родитель = Неопределено)
    Объект = Справочники[Имя].СоздатьЭлемент(); Объект.Код = "ASSIGN-" + Строка(Номер);
    Объект.Наименование = Метаданные.Справочники[Имя].Синоним + " " + Строка(Номер);
    Если Родитель <> Неопределено Тогда Объект.Родитель = Родитель; КонецЕсли;
    Возврат Объект;
КонецФункции

Функция Подготовить() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.PortalUsers");
    Если Не Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "Подготовка разрешена только в новой пустой учебной базе";
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Константы.OrganizationName.Установить("ООО «ЧРЗ»");
        Константы.DefaultPassHours.Установить(8);
        Группы = Новый Соответствие;
        Для Каждого Имя Из СтрРазделить("Sites,AccessZones,Positions", ",") Цикл
            Группа = Справочники[Имя].СоздатьГруппу(); Группа.Код = "ASSIGN-GROUP";
            Группа.Наименование = "ООО «ЧРЗ»"; Группа.Записать(); Группы.Вставить(Имя, Группа.Ссылка);
        КонецЦикла;
        Для Номер = 1 По 10 Цикл
            Н = Строка(Номер); Префикс = "A" + Н; Логины = "assignment." + Н + ".";
            Данные = AccessFixtures.Создать(Префикс, Логины);
            Площадка = Элемент("Sites", Номер, Группы["Sites"]); Площадка.Записать();
            Зона = Элемент("AccessZones", Номер, Группы["AccessZones"]); Зона.Site = Площадка.Ссылка; Зона.Записать();
            Должность = Элемент("Positions", Номер, Группы["Positions"]); Должность.Записать();
            Контрагент = Элемент("Contractors", Номер); Контрагент.TaxID = "ТЕСТ-" + Н; Контрагент.Записать();
            Транспорт = Элемент("Vehicles", Номер); Транспорт.LicensePlate = "УЧЕБНЫЙ-" + Н;
            Транспорт.Company = Контрагент.Ссылка; Транспорт.Записать();
            Ценность = Элемент("Assets", Номер); Ценность.Unit = "шт"; Ценность.Записать();
            Вид = Элемент("IncidentTypes", Номер); Вид.Severity = Перечисления.IncidentSeverities.Medium; Вид.Записать();
            // В журнал попадает реальная идемпотентная команда согласования.
            Тело = Новый Структура("id,expected_status,reason", Строка(Данные.request.УникальныйИдентификатор()), "submitted", "Учебное согласование");
            AccessCommands.ОбработатьКоманду(Логины + "approver", Строка(Новый УникальныйИдентификатор), "request.approve", AccessCommands.JSONСтрока(Тело));
            Пропуск = AccessPasses.Выдать(Логины + "guard", Данные.request);
            AccessPasses.Проход(Логины + "guard", Пропуск, Данные.checkpoint, "in");
            AccessPasses.Отозвать(Логины + "guard", Пропуск, "Учебный возврат");
            AccessPasses.Проход(Логины + "guard", Пропуск, Данные.checkpoint, "out");
            ВозвратПропуска = Документ("PassReturns", Логины + "guard"); ВозвратПропуска.Pass = Пропуск;
            ВозвратПропуска.Записать(РежимЗаписиДокумента.Проведение);
            Для Каждого Имя Из СтрРазделить("AssetReceipts,AssetExpenses", ",") Цикл
                Перемещение = Документ(Имя, Логины + "guard"); Перемещение.Asset = Ценность.Ссылка;
                Перемещение.Checkpoint = Данные.checkpoint; Перемещение.Quantity = ?(Имя = "AssetReceipts", 10, 3);
                Перемещение.Записать(РежимЗаписиДокумента.Проведение);
            КонецЦикла;
            Допуск = Документ("VehiclePermits", Логины + "guard"); Допуск.Vehicle = Транспорт.Ссылка;
            Допуск.Checkpoint = Данные.checkpoint; Допуск.ValidUntil = Допуск.Дата + 86400;
            Допуск.Записать(РежимЗаписиДокумента.Проведение);
            Нарушение = Документ("SecurityIncidents", Логины + "guard"); Нарушение.IncidentType = Вид.Ссылка;
            Нарушение.Checkpoint = Данные.checkpoint; Нарушение.DescriptionText = "Учебная проверка " + Н;
            Нарушение.Записать(РежимЗаписиДокумента.Проведение);
            Смена = Документ("ShiftTransfers", Логины + "guard"); Смена.Checkpoint = Данные.checkpoint;
            Выборка = Справочники.PortalUsers.Выбрать();
            Пока Выборка.Следующий() Цикл
                Если Выборка.Login = Логины + "guard" Тогда Смена.NextGuard = Выборка.Ссылка; Прервать; КонецЕсли;
            КонецЦикла;
            Смена.CommentText = "Учебная передача смены"; Смена.Записать(РежимЗаписиДокумента.Проведение);
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    Возврат Новый Структура("ok,examples,data_origin", Истина, 10, "synthetic");
КонецФункции

Функция Заполнить() Экспорт
    Подготовить();
    Таблица = Новый ТабличныйДокумент;
    Таблица.Область(1, 1).Текст = "ООО «ЧРЗ»: учебная база подготовлена";
    Таблица.Область(2, 1).Текст = "По 10 связанных примеров; операции проведены платформой 1С";
    Возврат Таблица;
КонецФункции

Функция Количество(Тип, Имя)
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Тип + "." + Имя);
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); Возврат Выборка.Количество;
КонецФункции

Функция Приемка() Экспорт
    УстановитьЧасовойПоясСеанса("UTC");
    Если Количество("Справочник", "PortalUsers") = 0 Тогда Подготовить(); КонецЕсли;
    Если Количество("БизнесПроцесс", "VisitApproval") = 0 Тогда
        НачатьТранзакцию();
        Попытка
            Для Номер = 1 По 10 Цикл
                Логины = "workflow." + Строка(Номер) + ".";
                Данные = AccessFixtures.Создать("W" + Строка(Номер), Логины);
                Процесс = AccessWorkflows.Создать("VisitApproval", Данные.request);
                Задача = AccessWorkflows.АктивнаяЗадача(Процесс);
                Отказ = Ложь;
                Попытка AccessWorkflows.ЗавершитьЗадачу(Задача, Логины + "requester"); Исключение Отказ = Истина; КонецПопытки;
                Если Не Отказ Тогда ВызватьИсключение "Заявитель выполнил задачу согласующего"; КонецЕсли;
                AccessWorkflows.ЗавершитьЗадачу(Задача, Логины + "approver");
                Если Данные.request.Status <> "approved" Тогда ВызватьИсключение "Маршрут не согласовал заявку"; КонецЕсли;
                AccessWorkflows.ЗавершитьЗадачу(AccessWorkflows.АктивнаяЗадача(Процесс), Логины + "guard");
                Если Не Процесс.Завершен Тогда ВызватьИсключение "Маршрут не завершился"; КонецЕсли;
            КонецЦикла;
            Выборка = Документы.SecurityIncidents.Выбрать();
            Пока Выборка.Следующий() Цикл
                Процесс = AccessWorkflows.Создать("IncidentHandling", Выборка.Ссылка);
                AccessWorkflows.ЗавершитьЗадачу(AccessWorkflows.АктивнаяЗадача(Процесс), "assignment.1.guard");
                AccessWorkflows.ЗавершитьЗадачу(AccessWorkflows.АктивнаяЗадача(Процесс), "assignment.1.admin");
                Если Не Процесс.Завершен Тогда ВызватьИсключение "Разбор нарушения не завершился"; КонецЕсли;
            КонецЦикла;
            ЗафиксироватьТранзакцию();
        Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    КонецЕсли;
    Счетчики = Новый Соответствие;
    Для Каждого Описание Из Метаданные.Справочники Цикл
        Число = Количество("Справочник", Описание.Имя);
        Если Число < 10 Тогда ВызватьИсключение "Мало примеров: " + Описание.Имя; КонецЕсли;
        Счетчики.Вставить("Catalog." + Описание.Имя, Число);
    КонецЦикла;
    Для Каждого Описание Из Метаданные.Документы Цикл
        Число = Количество("Документ", Описание.Имя);
        Если Число < 10 Тогда ВызватьИсключение "Мало документов: " + Описание.Имя; КонецЕсли;
        Счетчики.Вставить("Document." + Описание.Имя, Число);
    КонецЦикла;
    Для Каждого Описание Из Метаданные.БизнесПроцессы Цикл
        Число = Количество("БизнесПроцесс", Описание.Имя);
        Если Число < 10 Тогда ВызватьИсключение "Мало процессов: " + Описание.Имя; КонецЕсли;
        Счетчики.Вставить("BusinessProcess." + Описание.Имя, Число);
    КонецЦикла;
    Счетчики.Вставить("Task.AccessTasks", Количество("Задача", "AccessTasks"));
    СтрокиОтчетов = Новый Соответствие;
    Для Каждого Описание Из Метаданные.Отчеты Цикл
        Таблица = AccessReports.Данные(Описание.Имя, НачалоДня(ТекущаяДатаСеанса()), КонецДня(ТекущаяДатаСеанса()));
        Печать = AccessReports.Сформировать(Описание.Имя, НачалоДня(ТекущаяДатаСеанса()), КонецДня(ТекущаяДатаСеанса()));
        Если Таблица.Количество() = 0 Или Печать.ВысотаТаблицы < 5 Тогда ВызватьИсключение "Пустой отчёт: " + Описание.Имя; КонецЕсли;
        СтрокиОтчетов.Вставить(Описание.Имя, Таблица.Количество());
    КонецЦикла;
    // Проверка расхода сверх остатка в отдельной транзакции: данные не меняются.
    НачатьТранзакцию();
    Попытка
        Ценность = Справочники.Assets.НайтиПоКоду("ASSIGN-1");
        Точка = Справочники.Checkpoints.НайтиПоКоду("A1-POINT");
        Если AccessOperations.ОстатокЦенности(Ценность, Точка) <> 7 Тогда ВызватьИсключение "Остаток должен быть 10 - 3 = 7"; КонецЕсли;
        Расход = Документ("AssetExpenses", "assignment.1.guard"); Расход.Asset = Ценность;
        Расход.Checkpoint = Точка; Расход.Quantity = 8; Отказ = Ложь;
        Попытка Расход.Записать(РежимЗаписиДокумента.Проведение); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Отрицательный остаток не отклонён"; КонецЕсли;
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Новый Структура("ok,counts,reports,stock_check,workflow_role_check,data_origin", Истина, Счетчики, СтрокиОтчетов, Истина, Истина, "synthetic");
КонецФункции
