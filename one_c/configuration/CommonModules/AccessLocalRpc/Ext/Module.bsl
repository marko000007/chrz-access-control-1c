Функция КаталогОбмена()
    Соединение = СтрокаСоединенияИнформационнойБазы();
    Если Лев(Соединение, 5) <> "File=" Тогда ВызватьИсключение "Локальный адаптер требует файловую базу"; КонецЕсли;
    Начало = СтрНайти(Соединение, Символ(34));
    Остаток = Сред(Соединение, Начало + 1);
    КонецПути = СтрНайти(Остаток, Символ(34));
    Возврат Лев(Остаток, КонецПути - 1) + "/local-rpc/";
КонецФункции

Процедура ОбработатьФайл() Экспорт
    УстановитьЧасовойПоясСеанса("UTC");
    // Без параметров: клиент не выбирает путь, actor или команду.
    Каталог = КаталогОбмена();
    ФайлЗапроса = Новый Файл(Каталог + "request.json");
    Если Не ФайлЗапроса.Существует() Или ФайлЗапроса.Размер() > 270000 Тогда Возврат; КонецЕсли;
    Чтение = Новый ЧтениеТекста(ФайлЗапроса.ПолноеИмя, КодировкаТекста.UTF8);
    Текст = Чтение.Прочитать(); Чтение.Закрыть();
    ЗапросAPI = AccessCommands.JSONЗначение(Текст);
    Попытка
        Если ЗапросAPI["operation"] = "setup" Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.PortalUsers");
            Если Не Запрос.Выполнить().Пустой() Тогда
                AccessPolicy.Разрешить(ЗапросAPI["actor"], СтрРазделить("admin", ","));
                Ответ = Новый Структура("status,result", 200, Новый Структура("api_version,data", 1, Новый Структура("setup", "existing")));
            Иначе
                НачатьТранзакцию();
                Попытка
                    AccessFixtures.Создать("DEMO", "demo.");
                    Если ЗапросAPI["actor"] <> "demo.admin" Тогда
                        Владелец = Справочники.PortalUsers.СоздатьЭлемент();
                        Владелец.Наименование = "Администратор локального приложения";
                        Владелец.Login = ЗапросAPI["actor"];
                        Владелец.RoleCode = "admin"; Владелец.Active = Истина;
                        Владелец.Записать();
                    КонецЕсли;
                    ЗафиксироватьТранзакцию();
                Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
                Ответ = Новый Структура("status,result", 200, Новый Структура("api_version,data", 1, Новый Структура("setup,data_origin", "created", "synthetic")));
            КонецЕсли;
        Иначе
            Ответ = AccessApi.Обработать(ЗапросAPI);
        КонецЕсли;
    Исключение
        Ответ = Новый Структура("status,result", 500, Новый Структура("api_version,data,error", 1, Новый Структура, "Локальная операция не выполнена"));
        Ответ.Вставить("local_error", ОписаниеОшибки());
    КонецПопытки;
    Ответ.Вставить("request_id", ЗапросAPI["request_id"]);
    Запись = Новый ЗаписьТекста(Каталог + "response.json", КодировкаТекста.UTF8);
    Запись.Записать(AccessCommands.JSONСтрока(Ответ)); Запись.Закрыть();
КонецПроцедуры
