Процедура БлокироватьЗаявку(Ссылка) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Документ.Requests");
    Элемент.УстановитьЗначение("Ссылка", Ссылка);
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьЗапись(Объект, Логин) Экспорт
    Если Объект.ЭтоНовый() Тогда
        AccessRequests.ПроверитьНовую(Объект, Логин);
        Возврат;
    КонецЕсли;
    AccessPolicy.БлокироватьПрава();
    БлокироватьЗаявку(Объект.Ссылка);
    Старый = Объект.Ссылка.ПолучитьОбъект();
    Переход = "";
    Если Не Объект.ДополнительныеСвойства.Свойство("PortalTransition", Переход) Или Переход <> Объект.Status Тогда
        ВызватьИсключение "Изменение допускается только командой согласования";
    КонецЕсли;
    Для Каждого Поле Из СтрРазделить("Visitor,Host,Checkpoint,Purpose,StartsAt,EndsAt,RequesterLogin,Дата,Номер,ПометкаУдаления", ",") Цикл
        Если Объект[Поле] <> Старый[Поле] Тогда
            ВызватьИсключение "Реквизиты отправленной заявки неизменяемы";
        КонецЕсли;
    КонецЦикла;
    Если Старый.Status <> "submitted" Тогда
        ВызватьИсключение "CONFLICT: Решение уже принято";
    КонецЕсли;
    Если Объект.Status = "cancelled" Тогда
        Профиль = AccessPolicy.Разрешить(Логин, СтрРазделить("requester,admin", ","));
        Если Профиль.role <> "admin" И Старый.RequesterLogin <> Логин Тогда
            ВызватьИсключение "Отменять можно только свою заявку";
        КонецЕсли;
    ИначеЕсли Объект.Status = "approved" Или Объект.Status = "rejected" Тогда
        AccessPolicy.Разрешить(Логин, СтрРазделить("approver,admin", ","));
        Если Старый.RequesterLogin = Логин Тогда
            ВызватьИсключение "Нельзя согласовать собственную заявку";
        КонецЕсли;
    Иначе
        ВызватьИсключение "Недопустимый переход статуса";
    КонецЕсли;
    Если Объект.Status <> "approved" И ПустаяСтрока(СокрЛП(Объект.DecisionReason)) Тогда
        ВызватьИсключение "Укажите причину отказа или отмены";
    КонецЕсли;
    Объект.DecisionBy = Логин;
    Объект.DecisionAt = ТекущаяДатаСеанса();
КонецПроцедуры

Функция Изменить(Логин, Ссылка, ОжидаемыйСтатус, НовыйСтатус, Причина = "") Экспорт
    Своя = Не ТранзакцияАктивна();
    Если Своя Тогда НачатьТранзакцию(); КонецЕсли;
    Попытка
        AccessPolicy.БлокироватьПрава();
        Если НовыйСтатус = "cancelled" Тогда
            AccessPolicy.Разрешить(Логин, СтрРазделить("requester,admin", ","));
        Иначе
            AccessPolicy.Разрешить(Логин, СтрРазделить("approver,admin", ","));
        КонецЕсли;
        БлокироватьЗаявку(Ссылка);
        Объект = Ссылка.ПолучитьОбъект();
        Если Объект.Status = НовыйСтатус И Объект.DecisionBy = Логин И Объект.DecisionReason = Причина Тогда
            Если Своя Тогда ЗафиксироватьТранзакцию(); КонецЕсли;
            Возврат Ссылка;
        КонецЕсли;
        Если Объект.Status <> ОжидаемыйСтатус Тогда
            ВызватьИсключение "CONFLICT: Состояние заявки изменилось";
        КонецЕсли;
        Объект.Status = НовыйСтатус;
        Объект.DecisionReason = Причина;
        Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
        Объект.ДополнительныеСвойства.Вставить("PortalTransition", НовыйСтатус);
        Объект.Записать();
        Если Своя Тогда ЗафиксироватьТранзакцию(); КонецЕсли;
        Возврат Ссылка;
    Исключение
        Если Своя Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция Самопроверка() Экспорт
    НачатьТранзакцию();
    Попытка
        Данные = AccessFixtures.Создать();
        Ссылка = Изменить("fixture.approver", Данные.request, "submitted", "approved", "Учебное решение");
        Если Ссылка.Status <> "approved" Или Ссылка.DecisionBy <> "fixture.approver" Тогда
            ВызватьИсключение "Решение не сохранено";
        КонецЕсли;
        Если Изменить("fixture.approver", Ссылка, "submitted", "approved", "Учебное решение") <> Ссылка Тогда
            ВызватьИсключение "Повтор не идемпотентен";
        КонецЕсли;
        Отказ = Ложь;
        Попытка
            Изменить("fixture.approver", Ссылка, "submitted", "rejected", "Другое решение");
        Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Повторное решение не отклонено"; КонецЕсли;
        Объект = Ссылка.ПолучитьОбъект();
        Объект.RequesterLogin = "fixture.admin";
        Отказ = Ложь;
        Попытка Объект.Записать(); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Прямая правка не отклонена"; КонецЕсли;
        Результат = Новый Структура("ok,stage,checks,data_origin", Истина, "approvals", 4, "synthetic");
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Результат;
КонецФункции
