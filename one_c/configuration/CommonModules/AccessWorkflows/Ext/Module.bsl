// Запуск и продвижение настоящих бизнес-процессов и задач платформы.
Функция Создать(Имя, Основание) Экспорт
    Объект = БизнесПроцессы[Имя].СоздатьБизнесПроцесс(); Объект.Дата = ТекущаяДатаСеанса();
    Если Имя = "VisitApproval" Тогда Объект.Request = Основание;
    Иначе Объект.Incident = Основание; Объект.Resolution = "Учебный разбор: нарушение устранено"; КонецЕсли;
    Объект.Записать(); Объект.Старт();
    Возврат Объект.Ссылка;
КонецФункции

Функция АктивнаяЗадача(Процесс) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Задача.AccessTasks ГДЕ БизнесПроцесс = &Процесс И НЕ Выполнена И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Процесс", Процесс); Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет активной задачи"; КонецЕсли;
    Возврат Выборка.Ссылка;
КонецФункции

Процедура ЗавершитьЗадачу(Ссылка, Логин) Экспорт
    AccessPolicy.Разрешить(Логин, СтрРазделить(Ссылка.RequiredRole + ",admin", ","));
    Объект = Ссылка.ПолучитьОбъект(); Объект.ActorLogin = Логин;
    Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Объект.ВыполнитьЗадачу();
КонецПроцедуры
