Функция Создать() Экспорт
    Если Не ТранзакцияАктивна() Тогда
        ВызватьИсключение "Учебная фикстура требует явной транзакции";
    КонецЕсли;
    Для Каждого Роль Из СтрРазделить("requester,approver,guard,admin", ",") Цикл
        Пользователь = Справочники.PortalUsers.СоздатьЭлемент();
        Пользователь.Код = "TEST-FIX-" + Роль;
        Пользователь.Наименование = "Вымышленный " + Роль;
        Пользователь.Login = "fixture." + Роль;
        Пользователь.RoleCode = Роль;
        Пользователь.Active = Истина;
        Пользователь.Записать();
    КонецЦикла;
    Отдел = AccessCatalogs.Подразделение("TEST-FIX-DEPT", "Учебный отдел");
    Сотрудник = AccessCatalogs.Сотрудник("TEST-FIX-EMP", "Вымышленный сотрудник", Отдел);
    Посетитель = Справочники.Visitors.СоздатьЭлемент();
    Посетитель.Код = "TEST-FIX-VIS";
    Посетитель.Наименование = "Вымышленный посетитель";
    Посетитель.Записать();
    Точка = Справочники.Checkpoints.СоздатьЭлемент();
    Точка.Код = "TEST-FIX-POINT";
    Точка.Наименование = "Учебная проходная";
    Точка.Active = Истина;
    Точка.Записать();
    Цель = Справочники.VisitPurposes.СоздатьЭлемент();
    Цель.Код = "TEST-FIX-PURPOSE";
    Цель.Наименование = "Вымышленное посещение";
    Цель.Записать();
    Начало = ТекущаяДатаСеанса() - 60;
    Заявка = AccessRequests.Создать("fixture.requester", Посетитель.Ссылка, Сотрудник,
        Точка.Ссылка, Цель.Ссылка, Начало, Начало + 3600);
    Возврат Новый Структура("request,visitor,employee,checkpoint,purpose", Заявка, Посетитель.Ссылка, Сотрудник, Точка.Ссылка, Цель.Ссылка);
КонецФункции
