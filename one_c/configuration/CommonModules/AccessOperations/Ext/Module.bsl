// Документы проходной: полномочия, контроль остатков и атомарные движения.
Процедура ПроверитьДокумент(Объект) Экспорт
    AccessPolicy.БлокироватьПрава();
    Логин = ИмяПользователя();
    Объект.ДополнительныеСвойства.Свойство("PortalActor", Логин);
    Если ПустаяСтрока(Логин) Тогда Логин = Объект.ActorLogin; КонецЕсли;
    AccessPolicy.Разрешить(Логин, СтрРазделить("guard,admin", ","));
    Если Не ПустаяСтрока(Объект.ActorLogin) И Объект.ActorLogin <> Логин Тогда
        ВызватьИсключение "Ответственный должен совпадать с исполнителем";
    КонецЕсли;
    Объект.ActorLogin = Логин;
    Если Не Объект.ЭтоНовый() И Объект.Ссылка.Проведен Тогда
        ВызватьИсключение "Проведённый документ неизменяем; создайте отдельное действие";
    КонецЕсли;
    Если Объект.Дата = Дата(1, 1, 1) Тогда Объект.Дата = ТекущаяДатаСеанса(); КонецЕсли;
КонецПроцедуры

Процедура БлокироватьРегистр(Имя, Поля) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрНакопления." + Имя);
    Для Каждого Пара Из Поля Цикл
        Элемент.УстановитьЗначение(Пара.Ключ, Пара.Значение);
    КонецЦикла;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ОстатокПропуска(Пропуск) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(QuantityОстаток), 0) КАК Количество ИЗ РегистрНакопления.PassCustody.Остатки(, Pass = &Пропуск)");
    Запрос.УстановитьПараметр("Пропуск", Пропуск);
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Функция ОстатокЦенности(Ценность, Точка) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(QuantityОстаток), 0) КАК Количество ИЗ РегистрНакопления.AssetStock.Остатки(, Asset = &Ценность И Checkpoint = &Точка)");
    Запрос.УстановитьПараметр("Ценность", Ценность); Запрос.УстановитьПараметр("Точка", Точка);
    Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьТочку(Точка)
    Если Не ЗначениеЗаполнено(Точка) Или Точка.ПометкаУдаления Или Не Точка.Active Тогда
        ВызватьИсключение "Требуется действующая точка прохода";
    КонецЕсли;
КонецПроцедуры

Процедура Провести(Объект) Экспорт
    Имя = Объект.Метаданные().Имя;
    Если Имя = "PassIssues" Или Имя = "PassReturns" Тогда
        Если Не ЗначениеЗаполнено(Объект.Pass) Тогда ВызватьИсключение "Не выбран пропуск"; КонецЕсли;
        БлокироватьРегистр("PassCustody", Новый Структура("Pass", Объект.Pass));
        Количество = ОстатокПропуска(Объект.Pass);
        Если Имя = "PassIssues" Тогда
            Если Количество <> 0 Или Объект.Pass.State <> "active" Тогда
                ВызватьИсключение "Пропуск уже выдан или не действует";
            КонецЕсли;
            Вид = ВидДвиженияНакопления.Приход;
        Иначе
            Если Количество <> 1 Или Объект.Pass.State <> "revoked" Тогда
                ВызватьИсключение "Для возврата нужен отозванный пропуск на руках";
            КонецЕсли;
            Вид = ВидДвиженияНакопления.Расход;
        КонецЕсли;
        Набор = Объект.Движения.PassCustody; Набор.Записывать = Истина;
        Запись = Набор.Добавить(); Запись.Период = Объект.Дата;
        Запись.ВидДвижения = Вид; Запись.Pass = Объект.Pass; Запись.Quantity = 1;
    ИначеЕсли Имя = "AssetReceipts" Или Имя = "AssetExpenses" Тогда
        ПроверитьТочку(Объект.Checkpoint);
        Если Не ЗначениеЗаполнено(Объект.Asset) Или Объект.Asset.ПометкаУдаления Или Объект.Quantity <= 0 Тогда
            ВызватьИсключение "Укажите ценность и положительное количество";
        КонецЕсли;
        БлокироватьРегистр("AssetStock", Новый Структура("Asset,Checkpoint", Объект.Asset, Объект.Checkpoint));
        Если Имя = "AssetExpenses" Тогда
            Если ОстатокЦенности(Объект.Asset, Объект.Checkpoint) < Объект.Quantity Тогда
                ВызватьИсключение "Недостаточно ценностей на территории";
            КонецЕсли;
            Вид = ВидДвиженияНакопления.Расход; Объект.Direction = Перечисления.AssetDirections.Expense;
        Иначе
            Вид = ВидДвиженияНакопления.Приход; Объект.Direction = Перечисления.AssetDirections.Receipt;
        КонецЕсли;
        Набор = Объект.Движения.AssetStock; Набор.Записывать = Истина;
        Запись = Набор.Добавить(); Запись.Период = Объект.Дата; Запись.ВидДвижения = Вид;
        Запись.Asset = Объект.Asset; Запись.Checkpoint = Объект.Checkpoint; Запись.Quantity = Объект.Quantity;
    ИначеЕсли Имя = "VehiclePermits" Тогда
        ПроверитьТочку(Объект.Checkpoint);
        Если Не ЗначениеЗаполнено(Объект.Vehicle) Или Объект.Vehicle.ПометкаУдаления
            Или Объект.ValidUntil <= Объект.Дата Тогда ВызватьИсключение "Нужны транспорт и будущий срок допуска"; КонецЕсли;
        Запись = РегистрыСведений.VehicleAccess.СоздатьМенеджерЗаписи();
        Запись.Vehicle = Объект.Vehicle; Запись.Checkpoint = Объект.Checkpoint;
        Запись.ValidUntil = Объект.ValidUntil; Запись.Записать();
    ИначеЕсли Имя = "SecurityIncidents" Тогда
        ПроверитьТочку(Объект.Checkpoint);
        Если Не ЗначениеЗаполнено(Объект.IncidentType) Или ПустаяСтрока(СокрЛП(Объект.DescriptionText)) Тогда
            ВызватьИсключение "Укажите вид и описание нарушения";
        КонецЕсли;
    ИначеЕсли Имя = "ShiftTransfers" Тогда
        ПроверитьТочку(Объект.Checkpoint);
        Если Не ЗначениеЗаполнено(Объект.NextGuard) Или Не Объект.NextGuard.Active
            Или Объект.NextGuard.RoleCode <> "guard" Тогда ВызватьИсключение "Смену принимает действующий сотрудник проходной"; КонецЕсли;
    ИначеЕсли Имя = "PassRevocations" Тогда
        Если Не ЗначениеЗаполнено(Объект.Pass) Или Объект.Pass.State <> "revoked"
            Или Объект.Pass.RevokeReason <> Объект.Reason Тогда
            ВызватьИсключение "Акт должен соответствовать сохранённому отзыву пропуска";
        КонецЕсли;
    Иначе ВызватьИсключение "Неизвестный вид документа";
    КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьВыдачу(Пропуск, Логин) Экспорт
    Документ = Документы.PassIssues.СоздатьДокумент();
    Документ.Дата = ТекущаяДатаСеанса(); Документ.Pass = Пропуск;
    Документ.ActorLogin = Логин; Документ.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ЗаписатьОтзыв(Пропуск, Логин, Причина) Экспорт
    Документ = Документы.PassRevocations.СоздатьДокумент();
    Документ.Дата = ТекущаяДатаСеанса(); Документ.Pass = Пропуск;
    Документ.Reason = Причина; Документ.ActorLogin = Логин;
    Документ.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ПровестиПроход(Объект) Экспорт
    // Источником остаётся неизменяемое событие, проверенное AccessPasses.
    Набор = Объект.Движения.CheckpointVisits; Набор.Записывать = Истина;
    Запись = Набор.Добавить(); Запись.Период = Объект.OccurredAt;
    Запись.Visitor = Объект.Pass.Request.Visitor; Запись.Checkpoint = Объект.Checkpoint; Запись.Quantity = 1;
    Если Объект.Direction = "in" Тогда Запись.ВидДвижения = ВидДвиженияНакопления.Приход;
    Иначе Запись.ВидДвижения = ВидДвиженияНакопления.Расход; КонецЕсли;
КонецПроцедуры
