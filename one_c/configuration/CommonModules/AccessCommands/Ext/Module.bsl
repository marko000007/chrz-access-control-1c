Функция JSONСтрока(Значение) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

Функция JSONЗначение(Текст) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Результат = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция ДатаUTC(Текст) Экспорт
    Если ТипЗнч(Текст) <> Тип("Строка") Или (СтрДлина(Текст) <> 20 И СтрДлина(Текст) <> 25) Тогда
        ВызватьИсключение "Дата ISO8601 должна содержать часовой пояс и точность до секунды";
    КонецЕсли;
    Результат = XMLЗначение(Тип("Дата"), Лев(Текст, 19));
    Если СтрДлина(Текст) = 20 Тогда
        Если Прав(Текст, 1) <> "Z" Тогда ВызватьИсключение "Не указан UTC"; КонецЕсли;
        Возврат Результат;
    КонецЕсли;
    Знак = Сред(Текст, 20, 1);
    Если (Знак <> "+" И Знак <> "-") Или Сред(Текст, 23, 1) <> ":" Тогда
        ВызватьИсключение "Некорректный часовой пояс";
    КонецЕсли;
    Для Индекс = 21 По 25 Цикл
        Если Индекс <> 23 И СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
            ВызватьИсключение "Некорректное смещение";
        КонецЕсли;
    КонецЦикла;
    Часы = Число(Сред(Текст, 21, 2));
    Минуты = Число(Сред(Текст, 24, 2));
    Если Часы > 14 Или Минуты > 59 Или (Часы = 14 И Минуты <> 0) Тогда
        ВызватьИсключение "Смещение вне ISO8601";
    КонецЕсли;
    Смещение = (Часы * 60 + Минуты) * 60;
    Если Знак = "+" Тогда Возврат Результат - Смещение; КонецЕсли;
    Возврат Результат + Смещение;
КонецФункции

Функция СоздатьЗаявку(Логин, Данные)
    Если ТипЗнч(Данные) <> Тип("Соответствие") Или Данные.Количество() <> 6 Тогда
        ВызватьИсключение "Некорректные поля заявки";
    КонецЕсли;
    Посетитель = Справочники.Visitors.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["visitor_id"]));
    Сотрудник = Справочники.Employees.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["host_id"]));
    Точка = Справочники.Checkpoints.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["checkpoint_id"]));
    Цель = Справочники.VisitPurposes.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["purpose_id"]));
    Если Посетитель.ПолучитьОбъект() = Неопределено Или Сотрудник.ПолучитьОбъект() = Неопределено
        Или Точка.ПолучитьОбъект() = Неопределено Или Цель.ПолучитьОбъект() = Неопределено Тогда
        ВызватьИсключение "Справочник не существует";
    КонецЕсли;
    Начало = ДатаUTC(Данные["starts_at"]);
    Окончание = ДатаUTC(Данные["ends_at"]);
    Ссылка = AccessRequests.Создать(Логин, Посетитель, Сотрудник, Точка, Цель, Начало, Окончание);
    Возврат Новый Структура("id,status", Строка(Ссылка.УникальныйИдентификатор()), Ссылка.Status);
КонецФункции

Процедура ПроверитьПоля(Данные, Поля)
    Список = СтрРазделить(Поля, ",");
    Если ТипЗнч(Данные) <> Тип("Соответствие") Или Данные.Количество() <> Список.Количество() Тогда
        ВызватьИсключение "Неверный состав полей команды";
    КонецЕсли;
    Для Каждого Имя Из Список Цикл
        Если ТипЗнч(Данные[Имя]) <> Тип("Строка") Или СтрДлина(Данные[Имя]) > 150 Тогда
            ВызватьИсключение "Неверный тип или длина поля команды";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ОбработатьКоманду(Логин, Ключ, Команда, Тело) Экспорт
    // Прикладные права проверяются до возврата сохранённого результата.
    Своя = Не ТранзакцияАктивна();
    Если Своя Тогда НачатьТранзакцию(); КонецЕсли;
    Попытка
        AccessPolicy.БлокироватьПрава();
        Если Команда = "request.create" Тогда
            AccessPolicy.Разрешить(Логин, СтрРазделить("requester,admin", ","));
        ИначеЕсли Команда = "request.cancel" Тогда
            AccessPolicy.Разрешить(Логин, СтрРазделить("requester,admin", ","));
        ИначеЕсли Команда = "request.approve" Или Команда = "request.reject" Тогда
            AccessPolicy.Разрешить(Логин, СтрРазделить("approver,admin", ","));
        ИначеЕсли Команда = "pass.issue" Или Команда = "pass.revoke" Или Команда = "movement.register" Тогда
            AccessPolicy.Разрешить(Логин, СтрРазделить("guard,admin", ","));
        Иначе
            ВызватьИсключение "Неизвестная команда";
        КонецЕсли;
        Ключ = Строка(Новый УникальныйИдентификатор(Ключ));
        Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
        Хеширование.Добавить(Команда + Символы.ПС + Тело);
        Хеш = Base64Строка(Хеширование.ХешСумма);
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("Справочник.CommandJournal");
        Блокировка.Заблокировать();
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Журнал.PayloadSHA КАК Хеш, Журнал.ResponseJSON КАК Ответ ИЗ Справочник.CommandJournal КАК Журнал ГДЕ Журнал.ActorLogin = &Логин И Журнал.CommandKey = &Ключ");
        Запрос.УстановитьПараметр("Логин", Логин);
        Запрос.УстановитьПараметр("Ключ", Ключ);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Если Выборка.Хеш <> Хеш Тогда
                ВызватьИсключение "CONFLICT: ключ использован с другим содержимым";
            КонецЕсли;
            Ответ = JSONЗначение(Выборка.Ответ);
            Если Своя Тогда ЗафиксироватьТранзакцию(); КонецЕсли;
            Возврат Ответ;
        КонецЕсли;
        Данные = JSONЗначение(Тело);
        Если Команда = "request.create" Тогда
            ПроверитьПоля(Данные, "visitor_id,host_id,checkpoint_id,purpose_id,starts_at,ends_at");
            Ответ = СоздатьЗаявку(Логин, Данные);
        ИначеЕсли Команда = "pass.issue" Тогда
            ПроверитьПоля(Данные, "request_id");
            Заявка = Документы.Requests.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["request_id"]));
            Ответ = AccessPasses.Кратко(AccessPasses.Выдать(Логин, Заявка));
        ИначеЕсли Команда = "pass.revoke" Тогда
            ПроверитьПоля(Данные, "id,reason");
            Пропуск = Справочники.Passes.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["id"]));
            Ответ = AccessPasses.Кратко(AccessPasses.Отозвать(Логин, Пропуск, Данные["reason"]));
        ИначеЕсли Команда = "movement.register" Тогда
            ПроверитьПоля(Данные, "pass_id,checkpoint_id,direction");
            Пропуск = Справочники.Passes.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["pass_id"]));
            Точка = Справочники.Checkpoints.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["checkpoint_id"]));
            Событие = AccessPasses.Проход(Логин, Пропуск, Точка, Данные["direction"]);
            Ответ = Новый Структура("id,pass_id,direction", Строка(Событие.УникальныйИдентификатор()), Строка(Пропуск.УникальныйИдентификатор()), Событие.Direction);
        Иначе
            ПроверитьПоля(Данные, "id,expected_status,reason");
            Ссылка = Документы.Requests.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["id"]));
            Статусы = Новый Соответствие;
            Статусы.Вставить("request.approve", "approved");
            Статусы.Вставить("request.reject", "rejected");
            Статусы.Вставить("request.cancel", "cancelled");
            AccessApprovals.Изменить(Логин, Ссылка, Данные["expected_status"], Статусы[Команда], Данные["reason"]);
            Ответ = Новый Структура("id,status", Строка(Ссылка.УникальныйИдентификатор()), Ссылка.Status);
        КонецЕсли;
        Запись = Справочники.CommandJournal.СоздатьЭлемент();
        Запись.Наименование = "Команда " + Команда;
        Запись.ActorLogin = Логин;
        Запись.CommandKey = Ключ;
        Запись.PayloadSHA = Хеш;
        Запись.ResponseJSON = JSONСтрока(Ответ);
        Запись.ДополнительныеСвойства.Вставить("TrustedCommand", Истина);
        Запись.Записать();
        Если Своя Тогда ЗафиксироватьТранзакцию(); КонецЕсли;
        Возврат Ответ;
    Исключение
        Если Своя Тогда ОтменитьТранзакцию(); КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
КонецФункции

Функция Самопроверка() Экспорт
    НачатьТранзакцию();
    Попытка
        Данные = AccessFixtures.Создать();
        Если ДатаUTC("2026-11-23T12:00:00+04:00") <> ДатаUTC("2026-11-23T08:00:00Z") Тогда
            ВызватьИсключение "Смещение даты не применено";
        КонецЕсли;
        Тело = JSONСтрока(Новый Структура("id,expected_status,reason", Строка(Данные.request.УникальныйИдентификатор()), "submitted", "Вымышленное решение"));
        Ключ = Строка(Новый УникальныйИдентификатор);
        Первый = ОбработатьКоманду("fixture.approver", Ключ, "request.approve", Тело);
        Второй = ОбработатьКоманду("fixture.approver", Ключ, "request.approve", Тело);
        Если Первый.id <> Второй["id"] Тогда ВызватьИсключение "Повтор создал другой результат"; КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.CommandJournal ГДЕ ActorLogin = &ТестовыйАвтор");
        Запрос.УстановитьПараметр("ТестовыйАвтор", "fixture.approver");
        Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
        Если Выборка.Количество <> 1 Тогда ВызватьИсключение "Журнал содержит повтор"; КонецЕсли;
        Отказ = Ложь;
        Попытка ОбработатьКоманду("fixture.approver", Ключ, "request.approve", Тело + " "); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Изменённый payload не отклонён"; КонецЕсли;
        Результат = Новый Структура("ok,stage,checks,data_origin", Истина, "commands", 4, "synthetic");
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Результат;
КонецФункции
