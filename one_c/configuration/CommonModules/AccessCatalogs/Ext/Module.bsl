Функция Подразделение(Код, Наименование) Экспорт
    Если ПустаяСтрока(СокрЛП(Код)) Или ПустаяСтрока(СокрЛП(Наименование)) Тогда
        ВызватьИсключение "Укажите код и наименование подразделения";
    КонецЕсли;
    Найдено = Справочники.Departments.НайтиПоКоду(Код);
    Если ЗначениеЗаполнено(Найдено) Тогда
        Если Найдено.ПометкаУдаления Тогда
            ВызватьИсключение "Подразделение помечено на удаление";
        КонецЕсли;
        Возврат Найдено;
    КонецЕсли;
    Объект = Справочники.Departments.СоздатьЭлемент();
    Объект.Код = Код;
    Объект.Наименование = Наименование;
    Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Функция Сотрудник(Код, Наименование, Подразделение) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда
        ВызватьИсключение "Укажите подразделение сотрудника";
    КонецЕсли;
    Найдено = Справочники.Employees.НайтиПоКоду(Код);
    Если ЗначениеЗаполнено(Найдено) Тогда
        Возврат Найдено;
    КонецЕсли;
    Объект = Справочники.Employees.СоздатьЭлемент();
    Объект.Код = Код;
    Объект.Наименование = Наименование;
    Объект.Department = Подразделение;
    Объект.Active = Истина;
    Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Функция Самопроверка() Экспорт
    НачатьТранзакцию();
    Попытка
        Отдел = Подразделение("TEST-DEPT-001", "Учебное подразделение");
        Ссылка = Сотрудник("TEST-EMP-001", "Условный сотрудник", Отдел);
        Если Ссылка.Department <> Отдел Тогда
            ВызватьИсключение "Связь сотрудника с подразделением не сохранена";
        КонецЕсли;
        Если Подразделение("TEST-DEPT-001", "Другое название") <> Отдел Тогда
            ВызватьИсключение "Повтор кода создал другое подразделение";
        КонецЕсли;
        Отклонено = Ложь;
        Попытка
            Сотрудник("TEST-EMP-002", "Ошибка подразделения", Справочники.Departments.ПустаяСсылка());
        Исключение
            Отклонено = Истина;
        КонецПопытки;
        Если Не Отклонено Тогда
            ВызватьИсключение "Отсутствие подразделения не отклонено";
        КонецЕсли;
        Результат = Новый Структура("ok,stage,checks,data_origin", Истина, "catalogs", 3, "synthetic");
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Результат;
КонецФункции

Функция НовыйПосетитель(Логин, Имя, Компания) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Посетитель создается внутри команды"; КонецЕсли;
    AccessPolicy.Разрешить(Логин, СтрРазделить("admin", ","));
    Имя = СокрЛП(Имя); Компания = СокрЛП(Компания);
    Если ПустаяСтрока(Имя) Тогда ВызватьИсключение "Укажите имя посетителя"; КонецЕсли;
    Если СтрНайти(Имя + Компания, Символы.ПС) > 0 Или СтрНайти(Имя + Компания, Символы.ВК) > 0 Или СтрНайти(Имя + Компания, Символы.Таб) > 0 Тогда
        ВызватьИсключение "Недопустимые символы в справочнике";
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных; Блокировка.Добавить("Справочник.Visitors"); Блокировка.Заблокировать();
    Выборка = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник.Visitors ГДЕ НЕ ПометкаУдаления");
    ЧислоЗаписей = Выборка.Выполнить().Выбрать(); ЧислоЗаписей.Следующий();
    Если ЧислоЗаписей.Всего >= 500 Тогда ВызватьИсключение "Достигнут лимит посетителей локального прототипа"; КонецЕсли;
    Объект = Справочники.Visitors.СоздатьЭлемент(); Объект.Наименование = Имя; Объект.Company = Компания; Объект.Записать();
    Возврат Новый Структура("id,name,company", Строка(Объект.Ссылка.УникальныйИдентификатор()), Имя, Компания);
КонецФункции
