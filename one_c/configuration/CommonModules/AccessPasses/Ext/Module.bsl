Процедура Блокировать(Ссылка) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("Справочник.Passes");
    Элемент.УстановитьЗначение("Ссылка", Ссылка);
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьВход(Пропуск, Точка)
    Заявка = Пропуск.Request;
    Если Пропуск.State <> "active" Или Заявка.Status <> "approved" Или Заявка.ПометкаУдаления
        Или Заявка.Host.ПометкаУдаления Или Не Заявка.Host.Active
        Или Заявка.Visitor.ПометкаУдаления Или Точка.ПометкаУдаления Или Не Точка.Active Тогда
        ВызватьИсключение "Пропуск или справочники не действуют";
    КонецЕсли;
    Сейчас = ТекущаяДатаСеанса();
    Если Сейчас < Заявка.StartsAt Или Сейчас >= Заявка.EndsAt Тогда
        ВызватьИсключение "Вход вне срока действия";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗапись(Объект, Логин) Экспорт
    AccessPolicy.БлокироватьПрава();
    AccessPolicy.Разрешить(Логин, СтрРазделить("guard,admin", ","));
    Действие = "";
    Объект.ДополнительныеСвойства.Свойство("PassAction", Действие);
    Если Объект.ЭтоНовый() Тогда
        Если Действие <> "issue" Или Не ЗначениеЗаполнено(Объект.Request) Тогда
            ВызватьИсключение "Выдача допускается только серверной командой";
        КонецЕсли;
        Если Объект.Request.Status <> "approved" Или Объект.Request.ПометкаУдаления
            Или Объект.Request.EndsAt <= ТекущаяДатаСеанса() Тогда
            ВызватьИсключение "Нужна действующая согласованная заявка";
        КонецЕсли;
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("Справочник.Passes"); Блокировка.Заблокировать();
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Passes ГДЕ Request = &Заявка");
        Запрос.УстановитьПараметр("Заявка", Объект.Request);
        Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "CONFLICT: пропуск уже выдавался"; КонецЕсли;
        Объект.State = "active"; Объект.Position = "outside";
        Объект.IssuedBy = Логин; Объект.IssuedAt = ТекущаяДатаСеанса();
        Объект.RevokedBy = ""; Объект.RevokedAt = Дата(1, 1, 1); Объект.RevokeReason = "";
        Возврат;
    КонецЕсли;
    Блокировать(Объект.Ссылка);
    Старый = Объект.Ссылка.ПолучитьОбъект();
    Для Каждого Поле Из СтрРазделить("Request,IssuedBy,IssuedAt,Код,Наименование,ПометкаУдаления", ",") Цикл
        Если Объект[Поле] <> Старый[Поле] Тогда ВызватьИсключение "Реквизиты выданного пропуска неизменяемы"; КонецЕсли;
    КонецЦикла;
    Если Действие = "revoke" Тогда
        Если Старый.State <> "active" Или Объект.Position <> Старый.Position
            Или ПустаяСтрока(СокрЛП(Объект.RevokeReason)) Тогда ВызватьИсключение "CONFLICT: отзыв невозможен"; КонецЕсли;
        Объект.State = "revoked"; Объект.RevokedBy = Логин; Объект.RevokedAt = ТекущаяДатаСеанса();
    ИначеЕсли Действие = "move" Тогда
        Для Каждого Поле Из СтрРазделить("State,RevokedBy,RevokedAt,RevokeReason", ",") Цикл
            Если Объект[Поле] <> Старый[Поле] Тогда ВызватьИсключение "Проход не меняет состояние пропуска"; КонецЕсли;
        КонецЦикла;
        Если (Старый.Position = "outside" И Объект.Position <> "inside")
            Или (Старый.Position = "inside" И Объект.Position <> "outside") Тогда
            ВызватьИсключение "CONFLICT: положение не изменилось";
        КонецЕсли;
    Иначе ВызватьИсключение "Прямая правка пропуска закрыта";
    КонецЕсли;
КонецПроцедуры

Функция Выдать(Логин, Заявка) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Нужна транзакция команды"; КонецЕсли;
    AccessPolicy.БлокироватьПрава();
    AccessPolicy.Разрешить(Логин, СтрРазделить("guard,admin", ","));
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("Справочник.Passes"); Блокировка.Заблокировать();
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Passes ГДЕ Request = &Заявка");
    Запрос.УстановитьПараметр("Заявка", Заявка);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Если Выборка.Ссылка.State <> "active" Тогда ВызватьИсключение "CONFLICT: прежний пропуск отозван"; КонецЕсли;
        Возврат Выборка.Ссылка;
    КонецЕсли;
    Объект = Справочники.Passes.СоздатьЭлемент();
    Объект.Наименование = "Пропуск: " + Заявка.Visitor.Наименование;
    Объект.Request = Заявка; Объект.Kind = Перечисления.PassKinds.Visitor;
    Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Объект.ДополнительныеСвойства.Вставить("PassAction", "issue");
    ПроверитьЗапись(Объект, Логин);
    Объект.Записать();
    AccessOperations.ЗаписатьВыдачу(Объект.Ссылка, Логин);
    Возврат Объект.Ссылка;
КонецФункции

Функция Отозвать(Логин, Ссылка, Причина) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Нужна транзакция команды"; КонецЕсли;
    AccessPolicy.БлокироватьПрава();
    AccessPolicy.Разрешить(Логин, СтрРазделить("guard,admin", ","));
    Блокировать(Ссылка);
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект.State = "revoked" И Объект.RevokedBy = Логин И Объект.RevokeReason = Причина Тогда Возврат Ссылка; КонецЕсли;
    Объект.RevokeReason = Причина;
    Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Объект.ДополнительныеСвойства.Вставить("PassAction", "revoke");
    ПроверитьЗапись(Объект, Логин);
    Объект.Записать();
    AccessOperations.ЗаписатьОтзыв(Ссылка, Логин, Причина);
    Возврат Ссылка;
КонецФункции

Функция Проход(Логин, Ссылка, Точка, Направление) Экспорт
    Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Нужна транзакция команды"; КонецЕсли;
    AccessPolicy.БлокироватьПрава();
    AccessPolicy.Разрешить(Логин, СтрРазделить("guard,admin", ","));
    Блокировать(Ссылка);
    Объект = Ссылка.ПолучитьОбъект();
    Если Точка <> Объект.Request.Checkpoint Тогда ВызватьИсключение "Другая точка прохода"; КонецЕсли;
    Если Направление = "in" Тогда
        Если Объект.Position <> "outside" Тогда ВызватьИсключение "CONFLICT: посетитель уже внутри"; КонецЕсли;
        ПроверитьВход(Объект, Точка);
        Объект.Position = "inside";
    ИначеЕсли Направление = "out" Тогда
        Если Объект.Position <> "inside" Тогда ВызватьИсключение "CONFLICT: посетитель уже снаружи"; КонецЕсли;
        Объект.Position = "outside";
    Иначе ВызватьИсключение "Недопустимое направление";
    КонецЕсли;
    Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
    Объект.ДополнительныеСвойства.Вставить("PassAction", "move");
    ПроверитьЗапись(Объект, Логин);
    Объект.Записать();
    Событие = Документы.GateEvents.СоздатьДокумент();
    Событие.Дата = ТекущаяДатаСеанса(); Событие.OccurredAt = Событие.Дата;
    Событие.Pass = Ссылка; Событие.Checkpoint = Точка;
    Событие.Direction = Направление; Событие.ActorLogin = Логин;
    Событие.ДополнительныеСвойства.Вставить("TrustedMovement", Истина);
    ПроверитьСобытие(Событие);
    Событие.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Событие.Ссылка;
КонецФункции

Процедура ПроверитьСобытие(Объект) Экспорт
    Доверенное = Ложь;
    Объект.ДополнительныеСвойства.Свойство("TrustedMovement", Доверенное);
    Если Не Объект.ЭтоНовый() Или Не Доверенное Тогда ВызватьИсключение "Журнал проходов неизменяем"; КонецЕсли;
    AccessPolicy.Разрешить(Объект.ActorLogin, СтрРазделить("guard,admin", ","));
    Если Объект.Checkpoint <> Объект.Pass.Request.Checkpoint
        Или (Объект.Direction = "in" И Объект.Pass.Position <> "inside")
        Или (Объект.Direction = "out" И Объект.Pass.Position <> "outside") Тогда
        ВызватьИсключение "Несогласованное событие прохода";
    КонецЕсли;
КонецПроцедуры

Функция Кратко(Ссылка) Экспорт
    Возврат Новый Структура("id,state,position", Строка(Ссылка.УникальныйИдентификатор()), Ссылка.State, Ссылка.Position);
КонецФункции

Функция Самопроверка() Экспорт
    НачатьТранзакцию();
    Попытка
        Данные = AccessFixtures.Создать();
        Отказ = Ложь;
        Попытка Выдать("fixture.guard", Данные.request); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Выдан несогласованный пропуск"; КонецЕсли;
        AccessApprovals.Изменить("fixture.approver", Данные.request, "submitted", "approved");
        Ссылка = Выдать("fixture.guard", Данные.request);
        Если Выдать("fixture.guard", Данные.request) <> Ссылка Тогда ВызватьИсключение "Повторная выдача создала копию"; КонецЕсли;
        Проход("fixture.guard", Ссылка, Данные.checkpoint, "in");
        Если Ссылка.Position <> "inside" Тогда ВызватьИсключение "Вход не сохранён"; КонецЕсли;
        Отказ = Ложь;
        Попытка Проход("fixture.guard", Ссылка, Данные.checkpoint, "in"); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Двойной вход не отклонён"; КонецЕсли;
        Отозвать("fixture.guard", Ссылка, "Учебный отзыв");
        Проход("fixture.guard", Ссылка, Данные.checkpoint, "out");
        Если Ссылка.Position <> "outside" Или Ссылка.State <> "revoked" Тогда ВызватьИсключение "Выход после отзыва не сохранён"; КонецЕсли;
        Отказ = Ложь;
        Попытка Проход("fixture.guard", Ссылка, Данные.checkpoint, "in"); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Отозванный пропуск разрешил вход"; КонецЕсли;
        Отказ = Ложь;
        Попытка Выдать("fixture.requester", Данные.request); Исключение Отказ = Истина; КонецПопытки;
        Если Не Отказ Тогда ВызватьИсключение "Чужая роль выдала пропуск"; КонецЕсли;
        Результат = Новый Структура("ok,stage,checks,data_origin", Истина, "passes", 7, "synthetic");
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Результат;
КонецФункции
