Процедура БлокироватьПрава() Экспорт
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("Справочник.PortalUsers");
    Блокировка.Заблокировать();
КонецПроцедуры

Функция Профиль(Логин) Экспорт
    Если ПустаяСтрока(СокрЛП(Логин)) Тогда
        ВызватьИсключение "Не указан пользователь портала";
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Пользователи.RoleCode КАК Роль, Пользователи.Active КАК Активен ИЗ Справочник.PortalUsers КАК Пользователи ГДЕ Пользователи.Login = &Логин И НЕ Пользователи.ПометкаУдаления");
    Запрос.УстановитьПараметр("Логин", Логин);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Пользователь не допущен к системе";
    КонецЕсли;
    Роль = Выборка.Роль;
    Активен = Выборка.Активен;
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "Неоднозначное сопоставление пользователя";
    КонецЕсли;
    Роли = СтрРазделить("admin,requester,approver,guard", ",");
    Если Не Активен Или Роли.Найти(Роль) = Неопределено Тогда
        ВызватьИсключение "Доступ пользователя отключён";
    КонецЕсли;
    Возврат Новый Структура("actor,role", Логин, Роль);
КонецФункции

Функция Разрешить(Логин, РазрешенныеРоли) Экспорт
    Результат = Профиль(Логин);
    Если РазрешенныеРоли.Найти(Результат.role) = Неопределено Тогда
        ВызватьИсключение "Роль не разрешает это действие";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ТестовыйПользователь(Код, Логин, Роль)
    Объект = Справочники.PortalUsers.СоздатьЭлемент();
    Объект.Код = Код;
    Объект.Наименование = "Учебный пользователь";
    Объект.Login = Логин;
    Объект.RoleCode = Роль;
    Объект.Active = Истина;
    Объект.Записать();
    Возврат Объект;
КонецФункции

Функция ДолженБытьОтказ(Логин, Роли)
    Отклонено = Ложь;
    Попытка
        Разрешить(Логин, Роли);
    Исключение
        Отклонено = Истина;
    КонецПопытки;
    Если Не Отклонено Тогда
        ВызватьИсключение "Проверка доступа не отклонила запрос";
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция Самопроверка() Экспорт
    НачатьТранзакцию();
    Попытка
        Пользователь = ТестовыйПользователь("TEST-ACTOR-001", "test.requester", "requester");
        Если Профиль("test.requester").role <> "requester" Тогда
            ВызватьИсключение "Роль не прочитана из 1С";
        КонецЕсли;
        ДолженБытьОтказ("test.requester", СтрРазделить("guard", ","));
        Пользователь.Active = Ложь;
        Пользователь.Записать();
        ДолженБытьОтказ("test.requester", СтрРазделить("requester", ","));
        Пользователь.Active = Истина;
        Пользователь.Записать();
        ТестовыйПользователь("TEST-ACTOR-002", "test.requester", "admin");
        ДолженБытьОтказ("test.requester", СтрРазделить("admin,requester", ","));
        Результат = Новый Структура("ok,stage,checks,data_origin", Истина, "policy", 4, "synthetic");
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Результат;
КонецФункции
