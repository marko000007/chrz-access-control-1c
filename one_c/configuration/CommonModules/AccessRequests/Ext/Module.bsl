Процедура ПроверитьНовую(Объект, Логин) Экспорт
    AccessPolicy.БлокироватьПрава();
    AccessPolicy.Разрешить(Логин, СтрРазделить("requester,admin", ","));
    Если Не Объект.ЭтоНовый() Тогда
        ВызватьИсключение "Заявка после отправки не редактируется";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.Visitor) Или Не ЗначениеЗаполнено(Объект.Host)
        Или Не ЗначениеЗаполнено(Объект.Checkpoint) Или Не ЗначениеЗаполнено(Объект.Purpose) Тогда
        ВызватьИсключение "Заполните посетителя, сотрудника, точку прохода и цель";
    КонецЕсли;
    Если Объект.Host.ПометкаУдаления Или Не Объект.Host.Active
        Или Объект.Checkpoint.ПометкаУдаления Или Не Объект.Checkpoint.Active
        Или Объект.Visitor.ПометкаУдаления Или Объект.Purpose.ПометкаУдаления Тогда
        ВызватьИсключение "Выбран недействующий справочник";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.StartsAt) Или Объект.EndsAt <= Объект.StartsAt Тогда
        ВызватьИсключение "Окончание должно быть позже начала";
    КонецЕсли;
    Объект.RequesterLogin = Логин;
    Объект.Status = "submitted";
    Объект.DecisionBy = "";
    Объект.DecisionAt = Дата(1, 1, 1);
    Объект.DecisionReason = "";
КонецПроцедуры

Функция Создать(Логин, Посетитель, Сотрудник, ТочкаПрохода, Цель, Начало, Окончание) Экспорт
    СвояТранзакция = Не ТранзакцияАктивна();
    Если СвояТранзакция Тогда
        НачатьТранзакцию();
    КонецЕсли;
    Попытка
        Объект = Документы.Requests.СоздатьДокумент();
        Объект.Дата = ТекущаяДатаСеанса();
        Объект.Visitor = Посетитель;
        Объект.Host = Сотрудник;
        Объект.Checkpoint = ТочкаПрохода;
        Объект.Purpose = Цель;
        Объект.StartsAt = Начало;
        Объект.EndsAt = Окончание;
        Объект.ДополнительныеСвойства.Вставить("PortalActor", Логин);
        ПроверитьНовую(Объект, Логин);
        Объект.Записать();
        Результат = Объект.Ссылка;
        Если СвояТранзакция Тогда
            ЗафиксироватьТранзакцию();
        КонецЕсли;
    Исключение
        Если СвояТранзакция Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ВызватьИсключение;
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция Самопроверка() Экспорт
    НачатьТранзакцию();
    Попытка
        Пользователь = Справочники.PortalUsers.СоздатьЭлемент();
        Пользователь.Код = "TEST-REQ-ACTOR";
        Пользователь.Наименование = "Учебный заявитель";
        Пользователь.Login = "test.requester";
        Пользователь.RoleCode = "requester";
        Пользователь.Active = Истина;
        Пользователь.Записать();
        Отдел = AccessCatalogs.Подразделение("TEST-DEPT-REQ", "Учебное подразделение");
        Принимающий = AccessCatalogs.Сотрудник("TEST-EMP-REQ", "Условный сотрудник", Отдел);
        Посетитель = Справочники.Visitors.СоздатьЭлемент();
        Посетитель.Код = "TEST-VIS-REQ";
        Посетитель.Наименование = "Условный посетитель";
        Посетитель.Записать();
        Точка = Справочники.Checkpoints.СоздатьЭлемент();
        Точка.Код = "TEST-POINT-REQ";
        Точка.Наименование = "Учебная проходная";
        Точка.Active = Истина;
        Точка.Записать();
        Цель = Справочники.VisitPurposes.СоздатьЭлемент();
        Цель.Код = "TEST-PURPOSE-REQ";
        Цель.Наименование = "Учебное посещение";
        Цель.Записать();
        Начало = ТекущаяДатаСеанса() + 3600;
        Ссылка = Создать("test.requester", Посетитель.Ссылка, Принимающий, Точка.Ссылка, Цель.Ссылка, Начало, Начало + 3600);
        Если Ссылка.RequesterLogin <> "test.requester" Или Ссылка.Status <> "submitted" Тогда
            ВызватьИсключение "Автор или начальный статус не сохранён";
        КонецЕсли;
        ОтказПериода = Ложь;
        Попытка
            Создать("test.requester", Посетитель.Ссылка, Принимающий, Точка.Ссылка, Цель.Ссылка, Начало, Начало);
        Исключение
            ОтказПериода = Истина;
        КонецПопытки;
        Если Не ОтказПериода Тогда
            ВызватьИсключение "Некорректный период не отклонён";
        КонецЕсли;
        Точка.Active = Ложь;
        Точка.Записать();
        ОтказТочки = Ложь;
        Попытка
            Создать("test.requester", Посетитель.Ссылка, Принимающий, Точка.Ссылка, Цель.Ссылка, Начало, Начало + 3600);
        Исключение
            ОтказТочки = Истина;
        КонецПопытки;
        Если Не ОтказТочки Тогда
            ВызватьИсключение "Отключённая точка прохода не отклонена";
        КонецЕсли;
        Результат = Новый Структура("ok,stage,checks,data_origin", Истина, "requests", 3, "synthetic");
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    ОтменитьТранзакцию();
    Возврат Результат;
КонецФункции
