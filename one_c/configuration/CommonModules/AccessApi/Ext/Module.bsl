Функция Ответ(Код, Данные, Ошибка = "")
    Возврат Новый Структура("status,result", Код, Новый Структура("api_version,data,error", 1, Данные, Ошибка));
КонецФункции

Функция ДатаJSON(Значение) Экспорт
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция СправочникиПортала()
    Результат = Новый Структура;
    Таблицы = Новый Соответствие;
    Таблицы.Вставить("visitors", "Visitors");
    Таблицы.Вставить("employees", "Employees");
    Таблицы.Вставить("checkpoints", "Checkpoints");
    Таблицы.Вставить("purposes", "VisitPurposes");
    Для Каждого Пара Из Таблицы Цикл
        Фильтр = "НЕ ПометкаУдаления";
        Если Пара.Значение = "Employees" Или Пара.Значение = "Checkpoints" Тогда
            Фильтр = Фильтр + " И Active";
        КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 501 Ссылка, Наименование ИЗ Справочник." + Пара.Значение + " ГДЕ " + Фильтр + " УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
        Массив = Новый Массив;
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Массив.Добавить(Новый Структура("id,name", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование));
        КонецЦикла;
        Если Массив.Количество() > 500 Тогда ВызватьИсключение "Справочник превышает лимит"; КонецЕсли;
        Результат.Вставить(Пара.Ключ, Массив);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗаявкиПортала(Профиль)
    Фильтр = "НЕ ПометкаУдаления";
    Если Профиль.role = "requester" Тогда Фильтр = Фильтр + " И RequesterLogin = &Логин"; КонецЕсли;
    Если Профиль.role = "guard" Тогда Фильтр = Фильтр + " И Status = &Статус"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Документ.Requests ГДЕ " + Фильтр + " УПОРЯДОЧИТЬ ПО Дата УБЫВ, Ссылка");
    Запрос.УстановитьПараметр("Логин", Профиль.actor);
    Запрос.УстановитьПараметр("Статус", "approved");
    Выборка = Запрос.Выполнить().Выбрать();
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Ссылка = Выборка.Ссылка;
        Строки.Добавить(Новый Структура("id,visitor,requester_login,status,starts_at,ends_at",
            Строка(Ссылка.УникальныйИдентификатор()), Ссылка.Visitor.Наименование, Ссылка.RequesterLogin,
            Ссылка.Status, ДатаJSON(Ссылка.StartsAt), ДатаJSON(Ссылка.EndsAt)));
    КонецЦикла;
    Возврат Новый Структура("items", Строки);
КонецФункции

Функция Обработать(ЗапросAPI) Экспорт
    УстановитьЧасовойПоясСеанса("UTC");
    Логин = ЗапросAPI["actor"];
    Попытка
        Если ТипЗнч(Логин) <> Тип("Строка") Или СтрДлина(Логин) > 150 Тогда ВызватьИсключение "Неверный автор"; КонецЕсли;
        Профиль = AccessPolicy.Профиль(Логин);
    Исключение
        Возврат Ответ(403, Новый Структура, "Доступ закрыт");
    КонецПопытки;
    Метод = ЗапросAPI["method"];
    Путь = ЗапросAPI["path"];
    Попытка
        Если Метод = "GET" Тогда
            Если Путь = "/health" Тогда
                Возврат Ответ(200, Новый Структура("system,status", "1c-enterprise", "ok"));
            ИначеЕсли Путь = "/actors/me" Тогда
                Возврат Ответ(200, Профиль);
            ИначеЕсли Путь = "/references" Тогда
                Возврат Ответ(200, СправочникиПортала());
            ИначеЕсли Путь = "/requests" Тогда
                Возврат Ответ(200, ЗаявкиПортала(Профиль));
            КонецЕсли;
        ИначеЕсли Метод = "POST" Тогда
            Команда = "";
            Если Путь = "/requests" Тогда Команда = "request.create";
            ИначеЕсли Путь = "/requests/approve" Тогда Команда = "request.approve";
            ИначеЕсли Путь = "/requests/reject" Тогда Команда = "request.reject";
            ИначеЕсли Путь = "/requests/cancel" Тогда Команда = "request.cancel";
            КонецЕсли;
            Если Не ПустаяСтрока(Команда) Тогда
                Если (Команда = "request.create" Или Команда = "request.cancel") И Профиль.role <> "requester" И Профиль.role <> "admin" Тогда
                    Возврат Ответ(403, Новый Структура, "Роль не разрешает действие");
                КонецЕсли;
                Если (Команда = "request.approve" Или Команда = "request.reject") И Профиль.role <> "approver" И Профиль.role <> "admin" Тогда
                    Возврат Ответ(403, Новый Структура, "Роль не разрешает действие");
                КонецЕсли;
                Данные = AccessCommands.ОбработатьКоманду(Логин, ЗапросAPI["key"], Команда, ЗапросAPI["body"]);
                Возврат Ответ(200, Данные);
            КонецЕсли;
        КонецЕсли;
        Возврат Ответ(404, Новый Структура, "Маршрут не найден");
    Исключение
        Код = 400;
        Если СтрНайти(ОписаниеОшибки(), "CONFLICT:") > 0 Тогда Код = 409; КонецЕсли;
        Возврат Ответ(Код, Новый Структура, "Действие отклонено системой учёта");
    КонецПопытки;
КонецФункции
