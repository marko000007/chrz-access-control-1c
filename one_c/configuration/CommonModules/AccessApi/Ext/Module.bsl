Функция Ответ(Код, Данные, Ошибка = "")
    Возврат Новый Структура("status,result", Код, Новый Структура("api_version,data,error", 1, Данные, Ошибка));
КонецФункции

Функция ДатаJSON(Значение) Экспорт
    Возврат XMLСтрока(Значение) + "Z";
КонецФункции

Функция СправочникиПортала()
    Результат = Новый Структура;
    Таблицы = Новый Соответствие;
    Таблицы.Вставить("visitors", "Visitors");
    Таблицы.Вставить("employees", "Employees");
    Таблицы.Вставить("checkpoints", "Checkpoints");
    Таблицы.Вставить("purposes", "VisitPurposes");
    Для Каждого Пара Из Таблицы Цикл
        Фильтр = "НЕ ПометкаУдаления";
        Если Пара.Значение = "Employees" Или Пара.Значение = "Checkpoints" Тогда
            Фильтр = Фильтр + " И Active";
        КонецЕсли;
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 501 Ссылка, Наименование ИЗ Справочник." + Пара.Значение + " ГДЕ " + Фильтр + " УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
        Массив = Новый Массив;
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Массив.Добавить(Новый Структура("id,name", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование));
        КонецЦикла;
        Если Массив.Количество() > 500 Тогда ВызватьИсключение "Справочник превышает лимит"; КонецЕсли;
        Результат.Вставить(Пара.Ключ, Массив);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗаявкиПортала(Профиль)
    Фильтр = "НЕ ПометкаУдаления";
    Если Профиль.role = "requester" Тогда Фильтр = Фильтр + " И RequesterLogin = &Логин"; КонецЕсли;
    Если Профиль.role = "guard" Тогда Фильтр = Фильтр + " И Status = &Статус"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Документ.Requests ГДЕ " + Фильтр + " УПОРЯДОЧИТЬ ПО Дата УБЫВ, Ссылка");
    Запрос.УстановитьПараметр("Логин", Профиль.actor);
    Запрос.УстановитьПараметр("Статус", "approved");
    Выборка = Запрос.Выполнить().Выбрать();
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Ссылка = Выборка.Ссылка;
        Строки.Добавить(Новый Структура("id,visitor,requester_login,status,starts_at,ends_at",
            Строка(Ссылка.УникальныйИдентификатор()), Ссылка.Visitor.Наименование, Ссылка.RequesterLogin,
            Ссылка.Status, ДатаJSON(Ссылка.StartsAt), ДатаJSON(Ссылка.EndsAt)));
    КонецЦикла;
    Возврат Новый Структура("items", Строки);
КонецФункции

Функция КарточкаЗаявки(Профиль, Идентификатор)
    Ссылка = Документы.Requests.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
    Фильтр = "Ссылка = &Ссылка И НЕ ПометкаУдаления";
    Если Профиль.role = "requester" Тогда Фильтр = Фильтр + " И RequesterLogin = &Логин"; КонецЕсли;
    Если Профиль.role = "guard" Тогда Фильтр = Фильтр + " И Status = &Статус"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Requests ГДЕ " + Фильтр);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Запрос.УстановитьПараметр("Логин", Профиль.actor);
    Запрос.УстановитьПараметр("Статус", "approved");
    Если Запрос.Выполнить().Пустой() Тогда Возврат Неопределено; КонецЕсли;
    Запись = Новый Структура;
    Запись.Вставить("id", Идентификатор); Запись.Вставить("requester_login", Ссылка.RequesterLogin);
    Запись.Вставить("visitor", Ссылка.Visitor.Наименование); Запись.Вставить("host", Ссылка.Host.Наименование);
    Запись.Вставить("checkpoint", Ссылка.Checkpoint.Наименование); Запись.Вставить("purpose", Ссылка.Purpose.Наименование);
    Запись.Вставить("status", Ссылка.Status); Запись.Вставить("created_at", ДатаJSON(Ссылка.Дата));
    Запись.Вставить("starts_at", ДатаJSON(Ссылка.StartsAt)); Запись.Вставить("ends_at", ДатаJSON(Ссылка.EndsAt));
    Запись.Вставить("decision_by", Ссылка.DecisionBy); Запись.Вставить("decision_reason", Ссылка.DecisionReason);
    Решение = Неопределено;
    Если ЗначениеЗаполнено(Ссылка.DecisionAt) Тогда Решение = ДатаJSON(Ссылка.DecisionAt); КонецЕсли;
    Запись.Вставить("decision_at", Решение);
    Возврат Запись;
КонецФункции

Функция ПропускаПортала(Профиль)
    Фильтр = "НЕ ПометкаУдаления";
    Если Профиль.role = "requester" Тогда Фильтр = Фильтр + " И Request.RequesterLogin = &Логин"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Справочник.Passes ГДЕ " + Фильтр + " УПОРЯДОЧИТЬ ПО IssuedAt УБЫВ, Ссылка");
    Запрос.УстановитьПараметр("Логин", Профиль.actor);
    Выборка = Запрос.Выполнить().Выбрать();
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Пропуск = Выборка.Ссылка; Заявка = Пропуск.Request;
        ОписаниеПропуска = Новый Структура;
        ОписаниеПропуска.Вставить("id", Строка(Пропуск.УникальныйИдентификатор()));
        ОписаниеПропуска.Вставить("request_id", Строка(Заявка.УникальныйИдентификатор()));
        ОписаниеПропуска.Вставить("requester_login", Заявка.RequesterLogin);
        ОписаниеПропуска.Вставить("visitor", Заявка.Visitor.Наименование);
        ОписаниеПропуска.Вставить("checkpoint_id", Строка(Заявка.Checkpoint.УникальныйИдентификатор()));
        ОписаниеПропуска.Вставить("checkpoint", Заявка.Checkpoint.Наименование);
        ОписаниеПропуска.Вставить("state", Пропуск.State); ОписаниеПропуска.Вставить("position", Пропуск.Position);
        ОписаниеПропуска.Вставить("starts_at", ДатаJSON(Заявка.StartsAt)); ОписаниеПропуска.Вставить("ends_at", ДатаJSON(Заявка.EndsAt));
        ОписаниеПропуска.Вставить("issued_at", ДатаJSON(Пропуск.IssuedAt)); ОписаниеПропуска.Вставить("issued_by", Пропуск.IssuedBy);
        ОписаниеПропуска.Вставить("revoke_reason", Пропуск.RevokeReason);
        Строки.Добавить(ОписаниеПропуска);
    КонецЦикла;
    Возврат Новый Структура("items", Строки);
КонецФункции

Функция ОписаниеСобытия(Событие)
    Возврат Новый Структура("id,pass_id,direction,actor,visitor,checkpoint,occurred_at,requester_login",
            Строка(Событие.УникальныйИдентификатор()), Строка(Событие.Pass.УникальныйИдентификатор()), Событие.Direction,
            Событие.ActorLogin, Событие.Pass.Request.Visitor.Наименование, Событие.Checkpoint.Наименование,
            ДатаJSON(Событие.OccurredAt), Событие.Pass.Request.RequesterLogin);
КонецФункции

Функция СобытияПортала(Профиль)
    Фильтр = "НЕ ПометкаУдаления";
    Если Профиль.role = "requester" Тогда Фильтр = Фильтр + " И Pass.Request.RequesterLogin = &Логин"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Ссылка ИЗ Документ.GateEvents ГДЕ " + Фильтр + " УПОРЯДОЧИТЬ ПО OccurredAt УБЫВ, Ссылка");
    Запрос.УстановитьПараметр("Логин", Профиль.actor);
    Выборка = Запрос.Выполнить().Выбрать();
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Событие = Выборка.Ссылка;
        Строки.Добавить(ОписаниеСобытия(Событие));
    КонецЦикла;
    Возврат Новый Структура("items", Строки);
КонецФункции

Функция ДатаПериода(Текст)
    Если СтрДлина(Текст) <> 8 Тогда ВызватьИсключение "Неверная дата"; КонецЕсли;
    ГодПериода = Число(Лев(Текст, 4));
    Если ГодПериода < 1900 Или ГодПериода > 2100 Тогда ВызватьИсключение "Недопустимый год"; КонецЕсли;
    Возврат Дата(ГодПериода, Число(Сред(Текст, 5, 2)), Число(Прав(Текст, 2)));
КонецФункции

Функция ОтчетПоПроходам(Профиль, НачалоТекст, КонецТекст)
    Начало = ДатаПериода(НачалоТекст); Конец = ДатаПериода(КонецТекст) + 86400;
    Если Конец <= Начало Или Конец - Начало > 31 * 86400 Тогда ВызватьИсключение "Период отчета от1 до31 дней"; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1001 Ссылка ИЗ Документ.GateEvents ГДЕ НЕ ПометкаУдаления И OccurredAt >= &Начало И OccurredAt < &Конец УПОРЯДОЧИТЬ ПО OccurredAt, Ссылка");
    Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
    Выборка = Запрос.Выполнить().Выбрать(); Строки = Новый Массив; Входы = 0; Выходы = 0;
    Пока Выборка.Следующий() Цикл
        Событие = Выборка.Ссылка; Строки.Добавить(ОписаниеСобытия(Событие));
        Если Событие.Direction = "in" Тогда Входы = Входы + 1; Иначе Выходы = Выходы + 1; КонецЕсли;
        Если Строки.Количество() > 1000 Тогда ВызватьИсключение "Больше1000 событий, сократите период"; КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("items,starts_at,ends_at,generated_at,count_in,count_out", Строки,
        ДатаJSON(Начало), ДатаJSON(Конец), ДатаJSON(ТекущаяДатаСеанса()), Входы, Выходы);
КонецФункции

Функция Обработать(ЗапросAPI) Экспорт
    УстановитьЧасовойПоясСеанса("UTC");
    Логин = ЗапросAPI["actor"];
    Попытка
        Если ТипЗнч(Логин) <> Тип("Строка") Или СтрДлина(Логин) > 150 Тогда ВызватьИсключение "Неверный автор"; КонецЕсли;
        Профиль = AccessPolicy.Профиль(Логин);
    Исключение
        Возврат Ответ(403, Новый Структура, "Доступ закрыт");
    КонецПопытки;
    Метод = ЗапросAPI["method"];
    Путь = ЗапросAPI["path"];
    Попытка
        Если Метод = "GET" Тогда
            Если Путь = "/health" Тогда
                Возврат Ответ(200, Новый Структура("system,status", "1c-enterprise", "ok"));
            ИначеЕсли Путь = "/actors/me" Тогда
                Возврат Ответ(200, Профиль);
            ИначеЕсли Путь = "/references" Тогда
                Возврат Ответ(200, СправочникиПортала());
            ИначеЕсли Путь = "/requests" Тогда
                Возврат Ответ(200, ЗаявкиПортала(Профиль));
            ИначеЕсли Лев(Путь, 10) = "/requests/" И СтрДлина(Путь) = 46 Тогда
                Карточка = КарточкаЗаявки(Профиль, Сред(Путь, 11));
                Если Карточка = Неопределено Тогда Возврат Ответ(404, Новый Структура, "Заявка не найдена"); КонецЕсли;
                Возврат Ответ(200, Новый Структура("item", Карточка));
            ИначеЕсли Путь = "/passes" Тогда
                Возврат Ответ(200, ПропускаПортала(Профиль));
            ИначеЕсли Лев(Путь, 19) = "/reports/movements/" И СтрДлина(Путь) = 36 Тогда
                Если Профиль.role <> "admin" И Профиль.role <> "guard" Тогда Возврат Ответ(403, Новый Структура, "Роль не разрешает отчет"); КонецЕсли;
                Возврат Ответ(200, ОтчетПоПроходам(Профиль, Сред(Путь, 20, 8), Сред(Путь, 29, 8)));
            ИначеЕсли Путь = "/events" Тогда
                Возврат Ответ(200, СобытияПортала(Профиль));
            КонецЕсли;
        ИначеЕсли Метод = "POST" Тогда
            Команда = "";
            Если Путь = "/requests" Тогда Команда = "request.create";
            ИначеЕсли Путь = "/requests/approve" Тогда Команда = "request.approve";
            ИначеЕсли Путь = "/requests/reject" Тогда Команда = "request.reject";
            ИначеЕсли Путь = "/requests/cancel" Тогда Команда = "request.cancel";
            ИначеЕсли Путь = "/passes" Тогда Команда = "pass.issue";
            ИначеЕсли Путь = "/passes/revoke" Тогда Команда = "pass.revoke";
            ИначеЕсли Путь = "/movements" Тогда Команда = "movement.register";
            КонецЕсли;
            Если Не ПустаяСтрока(Команда) Тогда
                Если (Команда = "request.create" Или Команда = "request.cancel") И Профиль.role <> "requester" И Профиль.role <> "admin" Тогда
                    Возврат Ответ(403, Новый Структура, "Роль не разрешает действие");
                КонецЕсли;
                Если (Команда = "request.approve" Или Команда = "request.reject") И Профиль.role <> "approver" И Профиль.role <> "admin" Тогда
                    Возврат Ответ(403, Новый Структура, "Роль не разрешает действие");
                КонецЕсли;
                Если (Команда = "pass.issue" Или Команда = "pass.revoke" Или Команда = "movement.register") И Профиль.role <> "guard" И Профиль.role <> "admin" Тогда
                    Возврат Ответ(403, Новый Структура, "Роль не разрешает действие");
                КонецЕсли;
                Данные = AccessCommands.ОбработатьКоманду(Логин, ЗапросAPI["key"], Команда, ЗапросAPI["body"]);
                Возврат Ответ(200, Данные);
            КонецЕсли;
        КонецЕсли;
        Возврат Ответ(404, Новый Структура, "Маршрут не найден");
    Исключение
        Код = 400;
        Если СтрНайти(ОписаниеОшибки(), "CONFLICT:") > 0 Тогда Код = 409; КонецЕсли;
        Возврат Ответ(Код, Новый Структура, "Действие отклонено системой учёта");
    КонецПопытки;
КонецФункции
