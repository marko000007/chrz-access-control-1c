// Все пять отчётов строятся по данным платформы, а не по технической БД портала.
Функция Данные(Имя, Начало, Конец) Экспорт
    Если Начало > Конец Тогда ВызватьИсключение "Начало периода позже окончания"; КонецЕсли;
    Если Имя = "VisitJournal" Тогда
        Текст = "ВЫБРАТЬ E.OccurredAt КАК Время, V.Наименование КАК Посетитель, C.Наименование КАК Проходная, E.Direction КАК Направление
        |ИЗ Документ.GateEvents КАК E
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Passes КАК P ПО E.Pass = P.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Документ.Requests КАК R ПО P.Request = R.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Visitors КАК V ПО R.Visitor = V.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Checkpoints КАК C ПО E.Checkpoint = C.Ссылка
        |ГДЕ E.OccurredAt МЕЖДУ &Начало И &Конец И E.Проведен
        |УПОРЯДОЧИТЬ ПО Время";
    ИначеЕсли Имя = "ActivePasses" Тогда
        Текст = "ВЫБРАТЬ P.Наименование КАК Пропуск, E.Наименование КАК Принимающий, D.Наименование КАК Подразделение, R.EndsAt КАК Окончание
        |ИЗ Справочник.Passes КАК P
        |ЛЕВОЕ СОЕДИНЕНИЕ Документ.Requests КАК R ПО P.Request = R.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Employees КАК E ПО R.Host = E.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Departments КАК D ПО E.Department = D.Ссылка
        |ГДЕ P.State = ""active"" И НЕ P.ПометкаУдаления И R.EndsAt >= &Начало И R.StartsAt <= &Конец";
    ИначеЕсли Имя = "RequestDecisions" Тогда
        Текст = "ВЫБРАТЬ R.Номер КАК Номер, V.Наименование КАК Посетитель, E.Наименование КАК Принимающий, R.Status КАК Статус, R.DecisionReason КАК Основание
        |ИЗ Документ.Requests КАК R
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Visitors КАК V ПО R.Visitor = V.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Employees КАК E ПО R.Host = E.Ссылка
        |ГДЕ R.Дата МЕЖДУ &Начало И &Конец И НЕ R.ПометкаУдаления";
    ИначеЕсли Имя = "AssetBalance" Тогда
        Текст = "ВЫБРАТЬ A.Наименование КАК Ценность, C.Наименование КАК Проходная, A.Unit КАК Единица, B.QuantityОстаток КАК Количество
        |ИЗ РегистрНакопления.AssetStock.Остатки(&Момент) КАК B
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Assets КАК A ПО B.Asset = A.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Checkpoints КАК C ПО B.Checkpoint = C.Ссылка";
    ИначеЕсли Имя = "IncidentSummary" Тогда
        Текст = "ВЫБРАТЬ T.Наименование КАК Нарушение, C.Наименование КАК Проходная, T.Severity КАК Тяжесть, КОЛИЧЕСТВО(*) КАК Количество
        |ИЗ Документ.SecurityIncidents КАК I
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.IncidentTypes КАК T ПО I.IncidentType = T.Ссылка
        |ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Checkpoints КАК C ПО I.Checkpoint = C.Ссылка
        |ГДЕ I.Дата МЕЖДУ &Начало И &Конец И I.Проведен
        |СГРУППИРОВАТЬ ПО T.Наименование, C.Наименование, T.Severity";
    Иначе ВызватьИсключение "Неизвестный отчёт";
    КонецЕсли;
    Запрос = Новый Запрос(Текст); Запрос.УстановитьПараметр("Начало", Начало);
    Запрос.УстановитьПараметр("Конец", Конец);
    Запрос.УстановитьПараметр("Момент", Новый Граница(Конец, ВидГраницы.Включая));
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Сформировать(Имя, Начало, Конец) Экспорт
    Таблица = Данные(Имя, Начало, Конец);
    Печать = Новый ТабличныйДокумент;
    Печать.Область(1, 1).Текст = "ООО «ЧРЗ» — " + Метаданные.Отчеты[Имя].Синоним;
    Печать.Область(2, 1).Текст = "Период: " + Формат(Начало, "ДФ=dd.MM.yyyy HH:mm") + " — " + Формат(Конец, "ДФ=dd.MM.yyyy HH:mm");
    НомерКолонки = 1;
    Для Каждого Колонка Из Таблица.Колонки Цикл
        Печать.Область(4, НомерКолонки).Текст = Колонка.Имя; НомерКолонки = НомерКолонки + 1;
    КонецЦикла;
    НомерСтроки = 5;
    Для Каждого СтрокаДанных Из Таблица Цикл
        НомерКолонки = 1;
        Для Каждого Колонка Из Таблица.Колонки Цикл
            Печать.Область(НомерСтроки, НомерКолонки).Текст = Строка(СтрокаДанных[Колонка.Имя]);
            НомерКолонки = НомерКолонки + 1;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    Печать.Область(НомерСтроки + 1, 1).Текст = "Подворный Виталий Олегович · 70204645";
    Печать.АвтоМасштаб = Истина;
    Возврат Печать;
КонецФункции

Функция Порталу(Имя, Начало, Конец) Экспорт
    Если Конец - Начало > 31 * 86400 Тогда ВызватьИсключение "Период не более 31 дня"; КонецЕсли;
    Таблица = Данные(Имя, Начало, Конец);
    Если Таблица.Количество() > 1000 Тогда ВызватьИсключение "Сократите период: больше 1000 строк"; КонецЕсли;
    Колонки = Новый Массив; Строки = Новый Массив;
    Для Каждого Колонка Из Таблица.Колонки Цикл Колонки.Добавить(Колонка.Имя); КонецЦикла;
    Для Каждого Запись Из Таблица Цикл
        СтрокаТаблицы = Новый Массив;
        Для Каждого Колонка Из Таблица.Колонки Цикл СтрокаТаблицы.Добавить(Строка(Запись[Колонка.Имя])); КонецЦикла;
        Строки.Добавить(СтрокаТаблицы);
    КонецЦикла;
    Возврат Новый Структура("name,title,columns,rows", Имя, Метаданные.Отчеты[Имя].Синоним, Колонки, Строки);
КонецФункции
