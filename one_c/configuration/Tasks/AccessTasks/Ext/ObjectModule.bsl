// Нельзя завершить задачу от имени произвольного сотрудника в управляемой форме.
Процедура ПередЗаписью(Отказ)
    Если Не ЭтоНовый() Тогда
        Старый = Ссылка.ПолучитьОбъект();
        Если RequiredRole <> Старый.RequiredRole Или БизнесПроцесс <> Старый.БизнесПроцесс Тогда
            ВызватьИсключение "Маршрут и роль задачи неизменяемы";
        КонецЕсли;
    КонецЕсли;
    Если Выполнена Тогда
        Логин = ИмяПользователя();
        ДополнительныеСвойства.Свойство("PortalActor", Логин);
        AccessPolicy.Разрешить(Логин, СтрРазделить(RequiredRole + ",admin", ","));
        ActorLogin = Логин;
    КонецЕсли;
КонецПроцедуры
