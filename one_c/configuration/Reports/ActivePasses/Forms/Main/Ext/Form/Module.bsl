// Команда исполняется на сервере; на клиент передаётся готовая печатная форма.
&НаКлиенте
Процедура Generate(Команда)
    GenerateServer();
КонецПроцедуры

&НаСервере
Процедура GenerateServer()
    РезультатСервера = AccessReports.Сформировать("ActivePasses", PeriodStart, PeriodEnd);
    Result = РезультатСервера;
КонецПроцедуры

&НаКлиенте
Процедура Print(Команда)
    Если Result.ВысотаТаблицы = 0 Тогда
        Сообщить("Сначала сформируйте результат");
        Возврат;
    КонецЕсли;
    Result.Показать("Действующие пропуска");
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    PeriodStart = НачалоДня(ТекущаяДатаСеанса());
    PeriodEnd = КонецДня(ТекущаяДатаСеанса());
КонецПроцедуры
